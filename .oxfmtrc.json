{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules", "dist", "coverage", "*.log", ".DS_Store", ".git"]
}
