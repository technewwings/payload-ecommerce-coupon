{
  "type": "module",
  "name": "@wtree/payload-ecommerce-coupon",
  "version": "3.72.4",
  "description": "Production-ready coupon and referral system plugin for Payload CMS Ecommerce Plugin",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run clean && rolldown -c && tsc --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "bun run test && bun run build"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "ecommerce",
    "coupon",
    "referral",
    "promotion",
    "discount"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technewwings/payload-ecommerce-coupon.git"
  },
  "bugs": {
    "url": "https://github.com/technewwings/payload-ecommerce-coupon/issues"
  },
  "homepage": "https://github.com/technewwings/payload-ecommerce-coupon#readme",
  "author": "wtree",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "payload": "^3.75.0",
    "@payloadcms/plugin-ecommerce": ">=3.75.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "rolldown": "^1.0.0-rc.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.54.0"
  },
  "dependencies": {}
}
