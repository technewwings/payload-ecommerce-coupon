{
  "name": "@wtree/payload-ecommerce-coupon",
  "version": "3.79.5",
  "description": "Production-ready coupon and referral system plugin for Payload CMS Ecommerce Plugin",
  "keywords": [
    "coupon",
    "discount",
    "ecommerce",
    "payload",
    "payload-plugin",
    "payloadcms",
    "promotion",
    "referral"
  ],
  "homepage": "https://github.com/technewwings/payload-ecommerce-coupon#readme",
  "bugs": {
    "url": "https://github.com/technewwings/payload-ecommerce-coupon/issues"
  },
  "license": "MIT",
  "author": "wtree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technewwings/payload-ecommerce-coupon.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css"
  },
  "browser": {
    "./dist/index.mjs": "./dist/browser.mjs",
    "./dist/index.js": "./dist/browser.js"
  },
  "sideEffects": [
    "*.css",
    "dist/styles.css"
  ],
  "scripts": {
    "prepare": "bun run build",
    "build": "bun run clean && rolldown -c && tsc --declaration --emitDeclarationOnly --outDir dist && bun scripts/copy-styles.mjs",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt \"**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "prettier": "^3.8.1",
    "rolldown": "^1.0.0-rc.7",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@payloadcms/plugin-ecommerce": "^3.79.0",
    "payload": "^3.79.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
