{
  "name": "@wtree/payload-ecommerce-coupon",
  "version": "3.76.1",
  "description": "Production-ready coupon and referral system plugin for Payload CMS Ecommerce Plugin",
  "keywords": [
    "coupon",
    "discount",
    "ecommerce",
    "payload",
    "payload-plugin",
    "payloadcms",
    "promotion",
    "referral"
  ],
  "homepage": "https://github.com/technewwings/payload-ecommerce-coupon#readme",
  "bugs": {
    "url": "https://github.com/technewwings/payload-ecommerce-coupon/issues"
  },
  "license": "MIT",
  "author": "wtree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technewwings/payload-ecommerce-coupon.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run clean && rolldown -c && tsc --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt \"**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^25.2.3",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "prettier": "^3.0.0",
    "rolldown": "^1.0.0-rc.4",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@payloadcms/plugin-ecommerce": ">=3.76.1",
    "payload": "^3.76.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
